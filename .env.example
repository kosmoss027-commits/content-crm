# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# ─── База данных ──────────────────────────────────────────────
# Локально: npm run db:local (встроенный PostgreSQL на порту 54329), значения ниже уже подходят.
# В Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL — «Transaction pooler» (порт 6543), добавьте в конец ?pgbouncer=true
#   DIRECT_URL   — «Session pooler» (порт 5432), через него идут миграции
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/content_crm"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/content_crm"

# Отдельная база для автотестов (npm test). Тесты её очищают — не указывайте рабочую базу!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/content_crm_test"

# ─── Вход (Supabase Auth) ─────────────────────────────────────
# Supabase: Project Settings → API. URL проекта и «Publishable key» (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Адрес сайта: на него ведут ссылки из писем и возврат после входа через Google.
# Локально http://localhost:3000, на Railway — выданный домен, например https://content-crm.up.railway.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Только для локальной разработки ──────────────────────────
# DEV_AUTH="1" — вход без Supabase: на /login список тестовых пользователей из npm run db:seed.
# В production игнорируется. На сервере не задавайте.
DEV_AUTH=""
