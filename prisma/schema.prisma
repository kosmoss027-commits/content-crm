// Схема базы Content CRM.
// Правило мультипроектности: каждая таблица с данными проекта содержит
// workspaceId и projectId. Доступ к данным идёт только через lib/db/*.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // владелец: видит всё
  MANAGER // менеджер: клиенты, заявки, задачи
  ASSISTANT // ассистент: контент-план и завод
  SMM // SMM: контент-план и завод
}

/// Пользователь сервиса. id совпадает с id пользователя в Supabase Auth.
model User {
  id            String       @id @db.Uuid
  email         String       @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  invitesSent   Invite[]     @relation("InvitedBy")
  tasksAssigned Task[]       @relation("TaskAssignee")
  tasksCreated  Task[]       @relation("TaskCreator")
}

/// Рабочее пространство. У каждого клиента сервиса своё.
model Workspace {
  id          String       @id @default(cuid())
  name        String
  /// Тариф: ключ из config/plans.ts
  plan        String       @default("free")
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
  invites     Invite[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String    @db.Uuid
  role        Role
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Приглашение в пространство по email. Принимается по ссылке /invite/<token>.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role
  token       String    @unique
  invitedById String    @db.Uuid
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Проект: «Мой блог», «Клиент: автоподбор»…
model Project {
  id               String               @id @default(cuid())
  workspaceId      String
  name             String
  color            String               @default("#6366f1")
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  /// Порог «залёта» и «аномального залёта»: просмотры / медиана аккаунта
  viralThreshold   Float                @default(3)
  anomalyThreshold Float                @default(10)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  watchlist        WatchlistEntry[]
  reelMarks        ReelMark[]
  brandMap         BrandMap?
  reelAnalyses     ReelAnalysis[]
  techniques       Technique[]
  hypotheses       Hypothesis[]
  scripts          Script[]
  publications     Publication[]
  instagram        InstagramConnection?
  keywords         Keyword[]
  leads            Lead[]
  clients          Client[]
  payments         Payment[]
  mentions         KeywordMention[]
  warmups          WarmupCampaign[]
  warmupDays       WarmupDay[]
  tasks            Task[]

  @@index([workspaceId])
}

// ─── Разведка ───────────────────────────────────────────────
// Аккаунты и ролики конкурентов общие на всю систему: один аккаунт собирается один раз,
// даже если его отслеживают несколько проектов. Что видит проект, решает WatchlistEntry.

enum WatchStatus {
  WATCHING
  PAUSED
  CANDIDATE
}

enum Market {
  CIS
  FOREIGN
}

enum ScrapeRunKind {
  INITIAL // первый сбор нового аккаунта: последние ролики для медианы
  SCHEDULED // плановый сбор по расписанию
  MANUAL // кнопка «Собрать сейчас»
  PROFILE // подписчики и аватар
}

enum ScrapeRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED // не запущен: превышен лимит расходов
}

model ScrapedAccount {
  id                 String           @id @default(cuid())
  username           String           @unique
  fullName           String?
  avatarUrl          String?
  followers          Int?
  medianViews        Int?
  reelsCount         Int              @default(0)
  viralCount         Int              @default(0)
  avgViralMultiplier Float?
  rating             Float?
  lastScrapedAt      DateTime?
  lastProfileAt      DateTime?
  lastError          String?
  createdAt          DateTime         @default(now())
  reels              ScrapedReel[]
  watches            WatchlistEntry[]
}

model ScrapedReel {
  id             String           @id @default(cuid())
  shortCode      String           @unique
  accountId      String
  url            String
  postedAt       DateTime
  caption        String?
  /// Просмотры (plays) — та же цифра, что показывает Instagram
  views          Int
  likes          Int?
  comments       Int?
  durationSec    Float?
  videoUrl       String?
  coverUrl       String?
  musicTitle     String?
  musicArtist    String?
  hashtags       String[]
  isPinned       Boolean          @default(false)
  /// views / медиана аккаунта на момент последнего пересчёта
  multiplier     Float?
  firstSeenAt    DateTime         @default(now())
  viewsUpdatedAt DateTime         @default(now())
  account        ScrapedAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marks          ReelMark[]
  media          ReelMedia?
  analyses       ReelAnalysis[]
  hypotheses     HypothesisReel[]
  publications   Publication[]
  tasks          Task[]

  @@index([accountId, postedAt])
  @@index([postedAt])
}

/// Аккаунт в разведке конкретного проекта.
model WatchlistEntry {
  id          String         @id @default(cuid())
  workspaceId String
  projectId   String
  accountId   String
  status      WatchStatus    @default(WATCHING)
  market      Market         @default(CIS)
  niche       String?
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account     ScrapedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@index([workspaceId])
  @@index([accountId])
}

/// Отметка «В работу» на ролике (радар трендов, лента залётов).
model ReelMark {
  id          String      @id @default(cuid())
  workspaceId String
  projectId   String
  reelId      String
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reel        ScrapedReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([projectId, reelId])
}

/// Журнал сбора и учёт расходов.
model ScrapeRun {
  id             String          @id @default(cuid())
  kind           ScrapeRunKind
  status         ScrapeRunStatus
  /// Кто запустил вручную (для плановых сборов пусто)
  workspaceId    String?
  projectId      String?
  apifyRunId     String?         @unique
  usernames      String[]
  itemsCount     Int             @default(0)
  estimatedUsd   Float           @default(0)
  costUsd        Float           @default(0)
  error          String?
  /// Аккаунты, по которым сборщик вернул ошибку: «ник: причина»
  failedAccounts String[]
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  @@index([startedAt])
  @@index([status])
}

// ─── Разбор и сценарии (этап 3) ─────────────────────────────

enum AnalysisStatus {
  QUEUED // ждёт разбора
  FILTERED // отсеян проверкой на пользу для проекта
  ANALYZED // разобран
  FAILED
}

enum ScriptStatus {
  REVIEW // на одобрении
  SHOOT // снять
  EDIT // монтаж
  PUBLISH // выложить
  PUBLISHED // опубликовано
}

enum HypothesisStatus {
  TESTING
  CONFIRMED
  REJECTED
}

enum AiUsageKind {
  TRANSCRIPT
  RELEVANCE
  ANALYSIS
  SCRIPT
  REVISION
}

/// Расшифровка и кадры ролика. Общие на систему: делаются один раз для всех проектов.
model ReelMedia {
  id          String      @id @default(cuid())
  reelId      String      @unique
  transcript  String?
  /// Кадры JPEG 512px в base64
  frames      String[]
  error       String?
  processedAt DateTime    @default(now())
  reel        ScrapedReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
}

/// Карта бренда и профиль поиска проекта: Claude учитывает их при отборе, разборе и сценариях.
model BrandMap {
  id                 String   @id @default(cuid())
  workspaceId        String
  projectId          String   @unique
  author             String   @default("")
  niche              String   @default("")
  audience           String   @default("")
  products           String   @default("")
  tone               String   @default("")
  forbidden          String   @default("")
  examples           String   @default("")
  topics             String   @default("")
  keywords           String   @default("")
  exclusions         String   @default("")
  /// Ниже этой оценки пользы (0–10) ролик не разбирается
  relevanceThreshold Int      @default(6)
  scriptTemplate     String   @default("")
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Разбор залетевшего ролика под конкретный проект.
model ReelAnalysis {
  id              String         @id @default(cuid())
  workspaceId     String
  projectId       String
  reelId          String
  status          AnalysisStatus @default(QUEUED)
  /// Поставлен вручную («В работу» / «Разобрать сейчас») — идёт вне очереди и без отсева
  priority        Boolean        @default(false)
  relevance       Int?
  relevanceReason String?
  hook            String?
  hookType        String?
  structure       Json?
  techniques      String[]
  cta             String?
  codeWord        String?
  whyItWorked     String[]
  topic           String?
  format          String?
  niche           String?
  adaptationIdeas String[]
  error           String?
  costUsd         Float          @default(0)
  createdAt       DateTime       @default(now())
  analyzedAt      DateTime?
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reel            ScrapedReel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  scripts         Script[]

  @@unique([projectId, reelId])
  @@index([projectId, status])
}

/// Банк приёмов подачи и монтажа.
model Technique {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String   @default("")
  exampleUrl  String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Hypothesis {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  text        String
  note        String           @default("")
  status      HypothesisStatus @default(TESTING)
  createdAt   DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reels       HypothesisReel[]

  @@index([projectId])
}

model HypothesisReel {
  hypothesisId String
  reelId       String
  hypothesis   Hypothesis  @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  reel         ScrapedReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([hypothesisId, reelId])
}

/// Сценарий: хук → кадры → финал, к каждой фразе подсказка «что снимать».
model Script {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  analysisId  String?
  title       String
  hook        String
  /// [{ text, shoot }]
  shots       Json
  ending      String
  caption     String           @default("")
  status      ScriptStatus     @default(REVIEW)
  /// Создан автоматически утренним конвейером
  auto        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis    ReelAnalysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  revisions   ScriptRevision[]
  publication Publication?

  @@index([projectId, status])
}

model ScriptRevision {
  id          String   @id @default(cuid())
  scriptId    String
  instruction String
  /// Версия сценария до правки
  previous    Json
  createdAt   DateTime @default(now())
  script      Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

/// Расходы на ИИ (Claude, расшифровка речи).
model AiUsage {
  id           String      @id @default(cuid())
  kind         AiUsageKind
  workspaceId  String?
  projectId    String?
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costUsd      Float
  createdAt    DateTime    @default(now())

  @@index([createdAt])
}

// ─── CRM контента (этап 4) ──────────────────────────────────

enum Platform {
  INSTAGRAM
  STORIES
  THREADS
  TELEGRAM
  YOUTUBE
}

enum PublicationType {
  SALES // продающий / прогрев
  ENGAGING // вовлекающий / лайф
  EXPERT // экспертный
  CASE // кейс / отзыв
  ANNOUNCE // анонс / эфир
}

enum PublicationStatus {
  IDEA
  SCRIPT
  SHOOT
  EDIT
  READY
  PUBLISHED
}

/// Публикация в контент-плане проекта. Статистика: из Instagram API (если подключён) или вручную.
model Publication {
  id              String            @id @default(cuid())
  workspaceId     String
  projectId       String
  platform        Platform          @default(INSTAGRAM)
  type            PublicationType   @default(EXPERT)
  status          PublicationStatus @default(IDEA)
  /// День в плане (без времени). null — идея без даты
  date            DateTime?         @db.Date
  title           String
  text            String            @default("")
  note            String            @default("")
  codeWord        String?
  labels          String[]
  isStar          Boolean           @default(false)
  referenceReelId String?
  scriptId        String?           @unique
  // Публикация в Instagram
  igMediaId       String?
  permalink       String?
  mediaType       String?
  thumbnailUrl    String?
  publishedAt     DateTime?
  // Статистика из API
  views           Int?
  reach           Int?
  likes           Int?
  comments        Int?
  saves           Int?
  shares          Int?
  avgWatchSec     Float?
  statsUpdatedAt  DateTime?
  // Вносится вручную
  coldAudiencePct Float?
  profileVisits   Int?
  linkClicks      Int?
  follows         Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceReel   ScrapedReel?      @relation(fields: [referenceReelId], references: [id], onDelete: SetNull)
  script          Script?           @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  leads           Lead[]
  mentions        KeywordMention[]
  // Прогрев (этап 6)
  campaignId      String?
  rubric          Rubric?
  /// Смыслы прогрева: ключи из config/warmups.ts
  meanings        String[]
  campaign        WarmupCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  tasks           Task[]

  @@unique([projectId, igMediaId])
  @@index([projectId, date])
}

/// Подключённый Instagram проекта (официальный API, вход через Instagram). Токен хранится зашифрованным.
model InstagramConnection {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String    @unique
  igUserId       String
  username       String
  accessTokenEnc String
  expiresAt      DateTime
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Деньги (этап 5): кодовые слова → лиды → клиенты → оплаты ──

enum LeadSource {
  COMMENT // комментарий в Instagram
  DIRECT // директ
  TELEGRAM
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLIENT
  LOST
}

/// Кодовое слово проекта (ПУТЬ, ПЛАН…). word хранится заглавными: сравнение без учёта регистра.
model Keyword {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  word        String
  /// К какому продукту или лид-магниту ведёт
  product     String           @default("")
  note        String           @default("")
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leads       Lead[]
  clients     Client[]
  mentions    KeywordMention[]

  @@unique([projectId, word])
}

/// Кто-то написал кодовое слово в комментарии. Один комментарий — одна запись.
model KeywordMention {
  id            String       @id @default(cuid())
  workspaceId   String
  projectId     String
  keywordId     String
  publicationId String?
  handle        String
  igCommentId   String
  text          String       @default("")
  at            DateTime
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword       Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@unique([projectId, igCommentId, keywordId])
  @@index([projectId, keywordId, at])
}

/// Заявка. Относится к первой публикации, где человек написал слово (первое касание).
model Lead {
  id            String       @id @default(cuid())
  workspaceId   String
  projectId     String
  keywordId     String?
  publicationId String?
  clientId      String?
  /// Ник или имя; для Instagram — ник без @, строчными
  handle        String
  contact       String       @default("")
  source        LeadSource
  status        LeadStatus   @default(NEW)
  note          String       @default("")
  firstTouchAt  DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword       Keyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Одна заявка на человека и слово (NULL-слово не ограничено)
  @@unique([projectId, keywordId, handle])
  @@index([projectId, status])
  @@index([projectId, firstTouchAt])
}

model Client {
  id          String      @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  phone       String      @default("")
  telegram    String      @default("")
  instagram   String      @default("")
  email       String      @default("")
  source      LeadSource?
  keywordId   String?
  notes       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword     Keyword?    @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  leads       Lead[]
  payments    Payment[]
  tasks       Task[]

  @@index([projectId])
}

/// Оплата клиента. Деньги через сайт не идут — это запись для подсчёта выручки, в рублях.
model Payment {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  clientId    String
  amountRub   Int
  product     String   @default("")
  paidAt      DateTime @db.Date
  note        String   @default("")
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([projectId, paidAt])
}

// ─── Прогревы и задачи (этап 6) ─────────────────────────────

enum Rubric {
  LIFE // лайф
  CASE // кейс
  EXPERT // экспертный
  OFFER // оффер
  THOUGHTS // мысли
  STORIES // сторис
}

enum WarmupDayKind {
  START // старт прогрева
  LIVE // эфир
  IMPORTANT // важный день
  OPEN_DAY // день открытых дверей
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Кампания прогрева: период, продукт, старт продаж.
model WarmupCampaign {
  id             String        @id @default(cuid())
  workspaceId    String
  projectId      String
  name           String
  product        String        @default("")
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  salesStartDate DateTime?     @db.Date
  note           String        @default("")
  createdAt      DateTime      @default(now())
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  days           WarmupDay[]
  publications   Publication[]

  @@index([projectId, startDate])
}

/// День кампании: тип, значение дня, пост в Telegram, сторис, смыслы.
model WarmupDay {
  id           String         @id @default(cuid())
  workspaceId  String
  projectId    String
  campaignId   String
  date         DateTime       @db.Date
  kind         WarmupDayKind?
  meaning      String         @default("")
  telegramPost String         @default("")
  stories      String         @default("")
  meanings     String[]
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign     WarmupCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

/// Задача проекта: дедлайн, исполнитель, привязка к публикации, клиенту или ролику из разведки.
model Task {
  id            String       @id @default(cuid())
  workspaceId   String
  projectId     String
  title         String
  note          String       @default("")
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?    @db.Date
  assigneeId    String?      @db.Uuid
  createdById   String       @db.Uuid
  publicationId String?
  clientId      String?
  reelId        String?
  doneAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reel          ScrapedReel? @relation(fields: [reelId], references: [id], onDelete: SetNull)

  @@index([projectId, status, dueDate])
  @@index([assigneeId, status])
}
