{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "content-crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    {
      "name": "content-crm-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1",
        "DEV_AUTH": "1",
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:54329/content_crm",
        "DIRECT_URL": "postgresql://postgres:postgres@localhost:54329/content_crm",
        "APIFY_TOKEN": "",
        "OPENROUTER_API_KEY": "",
        "DEEPGRAM_API_KEY": "",
        "ADMIN_EMAILS": ""
      }
    }
  ]
}
